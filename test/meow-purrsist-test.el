;;; meow-purrsist-test.el --- Persistent selection checks -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'meow-purrsist)

(defmacro meow-purrsist-test--buffer (text &rest body)
  "Run BODY in a Lisp buffer containing TEXT with active regions enabled."
  (declare (indent 1))
  `(let ((transient-mark-mode t)
         (meow--selection-history nil))
     (with-temp-buffer
       (emacs-lisp-mode)
       (insert ,text)
       ,@body)))

(defun meow-purrsist-test--region (anchor active)
  "Set ordinary Emacs region from ANCHOR to ACTIVE."
  (goto-char active)
  (set-mark anchor)
  (activate-mark))

(ert-deftest meow-purrsist-adopts-native-regions-in-both-directions ()
  (dolist (bounds '((1 . 6) (6 . 1)))
    (meow-purrsist-test--buffer "alpha beta gamma"
      (meow-purrsist-test--region (car bounds) (cdr bounds))
      (meow-purrsist-adopt-region)
      (should (equal (cons (mark) (point)) bounds))
      (should (region-active-p))
      (should (equal (meow--selection-type) '(expand . char)))
      (meow-purrsist-move-to 12)
      (should (= (mark) (car bounds)))
      (should (= (point) 12))
      (should (= (length meow--selection-history) 1)))))

(ert-deftest meow-purrsist-word-motion-keeps-anchor-across-crossing ()
  (meow-purrsist-test--buffer "alpha beta gamma delta"
    (goto-char 3)
    (meow-purrsist-next-word 2)
    (should (= (point) 11))
    (should-not (region-active-p))
    (meow-purrsist-test--region 12 8)
    (meow-purrsist-adopt-region)
    (meow-purrsist-back-word 1)
    (should (equal (cons (mark) (point)) '(12 . 7)))
    (meow-purrsist-next-word 1)
    (should (equal (cons (mark) (point)) '(12 . 11)))
    (meow-purrsist-next-word 2)
    (should (equal (cons (mark) (point)) '(12 . 23)))
    (meow-purrsist-back-word 2)
    (should (= (mark) 12))
    (should (region-active-p))))

(ert-deftest meow-purrsist-symbol-motion-uses-symbol-boundaries ()
  (meow-purrsist-test--buffer "alpha_beta gamma-delta omega"
    (goto-char 3)
    (meow-purrsist-next-word 1)
    (should (= (point) 6))
    (goto-char 3)
    (meow-purrsist-next-symbol 1)
    (should (= (point) 11))
    (meow-purrsist-test--region 12 13)
    (meow-purrsist-adopt-region)
    (meow-purrsist-back-symbol 1)
    (should (equal (cons (mark) (point)) '(12 . 12)))
    (meow-purrsist-back-symbol 1)
    (should (= (mark) 12))
    (should (= (point) 1))
    (meow-purrsist-next-symbol 2)
    (should (= (mark) 12))
    (should (> (point) 12))))

(ert-deftest meow-purrsist-start-motions-respect-syntax-and-anchor ()
  (meow-purrsist-test--buffer "alpha_beta, gamma-delta epsilon"
    (goto-char 3)
    (meow-purrsist-next-word-start 1)
    (should (= (point) 7))
    (goto-char 3)
    (meow-purrsist-next-symbol-start 2)
    (should (= (point) 25))
    (meow-purrsist-test--region 3 11)
    (meow-purrsist-adopt-region)
    (meow-purrsist-next-symbol-start 1)
    (should (equal (cons (mark) (point)) '(3 . 13)))
    (meow-purrsist-next-symbol-start -1)
    (should (= (mark) 3))))

(ert-deftest meow-purrsist-extend-with-motion-retains-real-anchor ()
  (dolist (bounds '((4 . 8) (8 . 4)))
    (dolist (target '(1 6 12))
      (meow-purrsist-test--buffer "alpha beta gamma"
        (meow-purrsist-test--region (car bounds) (cdr bounds))
        (meow-purrsist-adopt-region)
        (meow-purrsist-extend-with-motion
         (lambda () (goto-char target)))
        (should (equal (cons (mark) (point))
                       (cons (car bounds) target)))
        (should (region-active-p))))))

(ert-deftest meow-purrsist-extend-with-meow-motion-keeps-history ()
  (meow-purrsist-test--buffer "alpha beta\ngamma delta\n"
    (goto-char 3)
    (meow-purrsist-visual)
    (let ((history-size (length meow--selection-history))
          (anchor (mark)))
      (meow-purrsist-extend-with-motion (lambda () (meow-next 1)))
      (should (= (mark) anchor))
      (should (= (length meow--selection-history) history-size))
      (should (region-active-p)))))

(ert-deftest meow-purrsist-visual-progresses-and-resets ()
  (meow-purrsist-test--buffer "(alpha_beta gamma)"
    (goto-char 3)
    (let ((last-command nil))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(2 . 7)))
    (should (equal (meow--selection-type) '(expand . char)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(2 . 12)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(1 . 19)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(1 . 19)))
    (meow-reverse)
    (let ((anchor (mark)))
      (meow-purrsist-next-word 1)
      (should (= (mark) anchor)))
    (goto-char 3)
    (let ((last-command 'meow-purrsist-next-word))
      (meow-purrsist-visual))
    (should (= meow-purrsist--visual-stage 1))
    (should (equal (meow--selection-type) '(expand . char)))))

(ert-deftest meow-purrsist-lines-move-physically-and-reverse ()
  (meow-purrsist-test--buffer "one\ntwo\nthree\nfour"
    (goto-char 6)
    (meow-line 1)
    (should (equal (cons (region-beginning) (region-end)) '(5 . 8)))
    (meow-purrsist-next 2)
    (should (equal (cons (region-beginning) (region-end)) '(5 . 19)))
    (meow-purrsist-prev 2)
    (should (equal (cons (region-beginning) (region-end)) '(5 . 8)))
    (meow-purrsist-prev 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 8)))
    (should (equal (meow--selection-type) '(expand . line)))
    (meow-reverse)
    (meow-purrsist-next 1)
    (should (equal (meow--selection-type) '(expand . line)))
    (should (region-active-p))
    (should (<= (point-min) (region-beginning)))
    (should (<= (region-end) (point-max)))))

(ert-deftest meow-purrsist-lines-skip-hidden-text ()
  ;; Folded bodies follow "one" and "two", as Org and Hideshow hide them.
  (meow-purrsist-test--buffer "one\nhidden\ntwo\nhidden2\nthree"
    (overlay-put (make-overlay 4 11) 'invisible t)
    (overlay-put (make-overlay 15 23) 'invisible t)
    (meow-purrsist--select 1 4 '(expand . line))
    (meow-purrsist-next 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 23)))
    (meow-purrsist-next 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 29)))
    (meow-purrsist-prev 2)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 4)))
    (meow-purrsist--select 24 29 '(expand . line))
    (meow-purrsist-prev 1)
    (should (equal (cons (region-beginning) (region-end)) '(12 . 29)))
    ;; A click after a folded line leaves point at the end of its body.
    (deactivate-mark)
    (goto-char 23)
    (let ((last-command nil))
      (meow-purrsist-line-or-rectangle 1))
    (should (= (region-beginning) 12))))

(ert-deftest meow-purrsist-line-rectangle-buffer-progression ()
  (meow-purrsist-test--buffer "one\ntwo\nthree"
    (goto-char 6)
    (let ((last-command nil))
      (meow-purrsist-line-or-rectangle 1))
    (should (equal (meow--selection-type) '(expand . line)))
    (let ((last-command 'meow-purrsist-line-or-rectangle))
      (meow-purrsist-line-or-rectangle 1))
    (should (bound-and-true-p rectangle-mark-mode))
    (should (= (point) 6))
    (let ((last-command 'meow-purrsist-line-or-rectangle))
      (meow-purrsist-line-or-rectangle 1))
    (should-not (bound-and-true-p rectangle-mark-mode))
    (should (equal (meow--selection-type) '(expand . char)))
    (should (equal (cons (region-beginning) (region-end))
                   (cons (point-min) (point-max))))
    (let ((last-command 'other-command))
      (meow-purrsist-line-or-rectangle 1))
    (should (equal (meow--selection-type) '(expand . line)))))

(ert-deftest meow-purrsist-rectangle-renders-with-meow-cursor-hack ()
  (let ((transient-mark-mode t)
        (meow-use-cursor-position-hack t)
        (was-global meow-global-mode)
        (was-purrsist meow-purrsist-mode))
    (unwind-protect
        (progn
          (unless was-global (meow-global-mode 1))
          (unless was-purrsist (meow-purrsist-mode 1))
          (save-window-excursion
            (meow-purrsist-test--buffer "one two\nthree four\nfive six\n"
              (set-window-buffer (selected-window) (current-buffer))
              (goto-char 3)
              (let ((last-command nil))
                (meow-purrsist-line-or-rectangle 1))
              (let ((last-command 'meow-purrsist-line-or-rectangle))
                (meow-purrsist-line-or-rectangle 1))
              (meow-purrsist-next 1)
              (meow-right)
              (should (bound-and-true-p rectangle-mark-mode))
              (let ((highlight (funcall redisplay-highlight-region-function
                                        (region-beginning) (region-end)
                                        (selected-window) nil)))
                (unwind-protect
                    (progn
                      (should (eq (car-safe highlight) 'rectangle))
                      (should (equal (sort (mapcar
                                            (lambda (overlay)
                                              (cons (overlay-start overlay)
                                                    (overlay-end overlay)))
                                            (nthcdr 6 highlight))
                                           (lambda (a b) (< (car a) (car b))))
                                     '((3 . 4) (11 . 12)))))
                  (funcall redisplay-unhighlight-region-function highlight))))))
      (unless was-global (meow-global-mode -1))
      (unless was-purrsist (meow-purrsist-mode -1)))))

(ert-deftest meow-purrsist-rectangle-cancellation-does-not-linger ()
  (meow-purrsist-test--buffer "one\ntwo\nthree"
    (goto-char 6)
    (let ((last-command nil))
      (meow-purrsist-line-or-rectangle 1))
    (let ((last-command 'meow-purrsist-line-or-rectangle))
      (meow-purrsist-line-or-rectangle 1))
    (should (bound-and-true-p rectangle-mark-mode))
    (meow-cancel-selection)
    (should-not (bound-and-true-p rectangle-mark-mode))
    (should-not (region-active-p))))

(ert-deftest meow-purrsist-visual-replaces-rectangle-cleanly ()
  (meow-purrsist-test--buffer "alpha beta\ngamma delta"
    (goto-char 3)
    (let ((last-command nil))
      (meow-purrsist-line-or-rectangle 1))
    (let ((last-command 'meow-purrsist-line-or-rectangle))
      (meow-purrsist-line-or-rectangle 1))
    (should (bound-and-true-p rectangle-mark-mode))
    (meow-purrsist-adopt-region)
    (should (bound-and-true-p rectangle-mark-mode))
    (let ((last-command 'other-command))
      (meow-purrsist-visual))
    (should-not (bound-and-true-p rectangle-mark-mode))
    (should (equal (meow--selection-type) '(expand . char)))
    (should (equal (buffer-substring-no-properties
                    (region-beginning) (region-end)) "alpha"))))

(ert-deftest meow-purrsist-find-and-till-keep-or-skip-selection ()
  (dolist (case '((meow-purrsist-find 8 19)
                  (meow-purrsist-till 7 18)
                  (meow-purrsist-find-backward 18 7)
                  (meow-purrsist-till-backward 19 8)))
    (meow-purrsist-test--buffer "alpha beta gamma beta"
      (goto-char (if (string-suffix-p "backward" (symbol-name (car case)))
                     (point-max) (point-min)))
      (funcall (car case) 1 ?b)
      (should-not (region-active-p))
      (should (= (point) (cadr case)))
      (meow-purrsist-test--region 12 13)
      (meow-purrsist-adopt-region)
      (funcall (car case) 1 ?b)
      (should (= (mark) 12))
      (should (= (point) (caddr case)))
      (should (region-active-p))
      (should (equal (meow--selection-type) '(expand . char)))
      (should (= (length meow--selection-history) 1)))))

(ert-deftest meow-purrsist-history-skips-fine-movement ()
  (meow-purrsist-test--buffer "alpha beta gamma"
    (goto-char 3)
    (meow-purrsist-visual)
    (let ((history-size (length meow--selection-history)))
      (meow-purrsist-next-word 1)
      (meow-purrsist-back-word 1)
      (meow-purrsist-move-to 14)
      (should (= (length meow--selection-history) history-size))
      (meow-pop-selection)
      (should-not (region-active-p)))))

(ert-deftest meow-purrsist-mode-advises-only-selected-things ()
  (let ((was-enabled meow-purrsist-mode))
    (unwind-protect
        (progn
          (meow-purrsist-mode 1)
          (meow-purrsist-mode 1)
          (dolist (command meow-purrsist--thing-commands)
            (should (advice-member-p #'meow-purrsist--adopt-meow-thing command)))
          (dolist (case '((meow-beginning-of-thing . meow-right)
                          (meow-end-of-thing . meow-left)
                          (meow-inner-of-thing . meow-left)
                          (meow-bounds-of-thing . meow-right)))
            (meow-purrsist-test--buffer "alpha beta"
              (goto-char 3)
              (funcall (car case) ?e)
              (should (equal (meow--selection-type) '(expand . char)))
              (let ((before (point)))
                (funcall (cdr case))
                (should (region-active-p))
                (should-not (= (point) before))))))
      (meow-purrsist-mode -1)
      (dolist (command meow-purrsist--thing-commands)
        (should-not (advice-member-p #'meow-purrsist--adopt-meow-thing command)))
      (when was-enabled
        (meow-purrsist-mode 1)))))

(ert-deftest meow-purrsist-line-crossing-keeps-line-type-and-history ()
  (meow-purrsist-test--buffer "one\ntwo\nthree\nfour"
    (goto-char 6)
    (meow-line 1)
    (let ((history-size (length meow--selection-history)))
      (meow-purrsist-prev 1)
      (should (equal (cons (mark) (point)) '(8 . 1)))
      (should (equal (cons (region-beginning) (region-end)) '(1 . 8)))
      (meow-purrsist-next 1)
      (should (equal (cons (region-beginning) (region-end)) '(5 . 8)))
      (meow-purrsist-next 3)
      (should (= (region-end) (point-max)))
      (meow-purrsist-next 1)
      (should (= (region-end) (point-max)))
      (should (equal (meow--selection-type) '(expand . line)))
      (should (= (length meow--selection-history) history-size))
      (meow-pop-selection)
      (should-not (region-active-p)))))

(ert-deftest meow-purrsist-semantic-selection-can-pop-previous-bounds ()
  (meow-purrsist-test--buffer "alpha_beta gamma"
    (goto-char 3)
    (let ((last-command nil))
      (meow-purrsist-visual))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (meow-purrsist-move-to (point-max))
    (meow-pop-selection)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 6)))
    (should (equal (meow--selection-type) '(expand . char)))))

(ert-deftest meow-purrsist-reversal-moves-new-active-end ()
  (meow-purrsist-test--buffer "alpha beta gamma"
    (goto-char 3)
    (meow-purrsist-visual)
    (meow-purrsist-next-word 1)
    (meow-reverse)
    (let ((anchor (mark)))
      (meow-purrsist-next-word 2)
      (should (= (mark) anchor))
      (meow-purrsist-back-word 1)
      (should (= (mark) anchor))
      (should (region-active-p)))))

(provide 'meow-purrsist-test)

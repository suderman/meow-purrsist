(ert-deftest meow-purrsist-extend-with-motion-retains-real-anchor ()
  (dolist (bounds '((4 . 8) (8 . 4)))
    (dolist (target '(1 6 12))
      (meow-purrsist-test--buffer "alpha beta gamma"
        (meow-purrsist-test--region (car bounds) (cdr bounds))
        (meow-purrsist-adopt-region)
        (meow-purrsist-extend-with-motion
         (lambda () (goto-char target)))
        (should (equal (cons (mark) (point))
                       (cons (car bounds) target)))
        (should (region-active-p))))))

(ert-deftest meow-purrsist-extend-with-meow-motion-keeps-history ()
  (meow-purrsist-test--buffer "alpha beta\ngamma delta\n"
    (goto-char 3)
    (meow-purrsist-visual)
    (let ((history-size (length meow--selection-history))
          (anchor (mark)))
      (meow-purrsist-extend-with-motion (lambda () (meow-next 1)))
      (should (= (mark) anchor))
      (should (= (length meow--selection-history) history-size))
      (should (region-active-p)))))

(ert-deftest meow-purrsist-visual-progresses-and-resets ()
  (meow-purrsist-test--buffer "(alpha_beta gamma)"
    (goto-char 3)
    (let ((last-command nil))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(2 . 7)))
    (should (equal (meow--selection-type) '(expand . char)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(2 . 12)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(2 . 18)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(1 . 19)))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(1 . 19)))
    (meow-reverse)
    (let ((anchor (mark)))
      (meow-purrsist-next-word 1)
      (should (= (mark) anchor)))
    (goto-char 3)
    (let ((last-command 'meow-purrsist-next-word))
      (meow-purrsist-visual))
    (should (equal (cons (region-beginning) (region-end)) '(2 . 7)))
    (should (equal (meow--selection-type) '(expand . char)))))

(ert-deftest meow-purrsist-visual-grows-through-prose-and-pops-back ()
  (let ((transient-mark-mode t)
        (meow--selection-history nil)
        (sentence-end-double-space nil))
    (with-temp-buffer
      (outline-mode)
      (insert "* Top\n** Sub\nOne here. Two (big cat) now.\n\nNext.\n")
      (goto-char (point-min))
      (search-forward "big")
      (let ((last-command nil))
        (meow-purrsist-visual))
      (dolist (expected '("big cat" "(big cat)" "Two (big cat) now."
                          "One here. Two (big cat) now."
                          "** Sub\nOne here. Two (big cat) now.\n\nNext."))
        (let ((last-command 'meow-purrsist-visual))
          (meow-purrsist-visual))
        (should (equal (buffer-substring (region-beginning) (region-end))
                       expected)))
      (meow-pop-selection)
      (should (equal (buffer-substring (region-beginning) (region-end))
                     "One here. Two (big cat) now.")))))


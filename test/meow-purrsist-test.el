(ert-deftest meow-purrsist-repeat-finds-again-or-falls-back ()
  (meow-purrsist-test--buffer "abcabcabc"
    (let ((meow--last-find nil)
          (meow-purrsist-repeat-function nil)
          (this-command nil))
      (goto-char (point-min))
      (meow-purrsist-find 1 ?c)
      (should (= (point) 4))
      (let ((last-command 'meow-purrsist-find))
        (meow-purrsist-repeat 1))
      (should (= (point) 7))
      ;; A failed find leaves nothing to repeat, not the earlier character.
      (meow-purrsist-find 1 ?z)
      (let ((last-command 'meow-purrsist-find))
        (should-error (meow-purrsist-repeat 1) :type 'user-error))
      (should (= (point) 7))
      (let ((last-command 'self-insert-command))
        (should-error (meow-purrsist-repeat 1) :type 'user-error)
        (let* ((counts nil)
               (meow-purrsist-repeat-function (lambda (n) (push n counts))))
          (meow-purrsist-repeat 3)
          (should (equal counts '(3))))))))

(ert-deftest meow-purrsist-mode-adopts-other-regions-in-normal-state ()
  (let ((was-enabled meow-purrsist-mode))
    (unwind-protect
        (progn
          (meow-purrsist-mode 1)
          (dolist (command meow-purrsist--region-commands)
            (should (advice-member-p #'meow-purrsist--adopt-normal-region
                                     command)))
          (meow-purrsist-test--buffer "alpha beta"
            (meow-purrsist-test--region 1 6)
            (let ((meow-normal-mode nil))
              (meow-purrsist--adopt-normal-region))
            (should-not (meow--selection-type))
            (let ((meow-normal-mode t))
              (meow-purrsist--adopt-normal-region))
            (should (equal (meow--selection-type) '(expand . char)))))
      (meow-purrsist-mode -1)
      (dolist (command meow-purrsist--region-commands)
        (should-not (advice-member-p #'meow-purrsist--adopt-normal-region
                                     command)))
      (when was-enabled
        (meow-purrsist-mode 1)))))

(ert-deftest meow-purrsist-history-skips-fine-movement ()
  (meow-purrsist-test--buffer "alpha beta gamma"
    (goto-char 3)
    (meow-purrsist-visual)
    (let ((history-size (length meow--selection-history)))
      (meow-purrsist-next-word 1)
      (meow-purrsist-back-word 1)
      (meow-purrsist-move-to 14)
      (should (= (length meow--selection-history) history-size))
      (meow-pop-selection)
      (should-not (region-active-p)))))

(ert-deftest meow-purrsist-mode-advises-only-selected-things ()
  (let ((was-enabled meow-purrsist-mode))
    (unwind-protect
        (progn
          (meow-purrsist-mode 1)
          (meow-purrsist-mode 1)
          (dolist (command meow-purrsist--thing-commands)
            (should (advice-member-p #'meow-purrsist--adopt-meow-thing command)))
          (dolist (case '((meow-beginning-of-thing . meow-right)
                          (meow-end-of-thing . meow-left)
                          (meow-inner-of-thing . meow-left)
                          (meow-bounds-of-thing . meow-right)))
            (meow-purrsist-test--buffer "alpha beta"
              (goto-char 3)
              (funcall (car case) ?e)
              (should (equal (meow--selection-type) '(expand . char)))
              (let ((before (point)))
                (funcall (cdr case))
                (should (region-active-p))
                (should-not (= (point) before))))))
      (meow-purrsist-mode -1)
      (dolist (command meow-purrsist--thing-commands)
        (should-not (advice-member-p #'meow-purrsist--adopt-meow-thing command)))
      (when was-enabled
        (meow-purrsist-mode 1)))))

(ert-deftest meow-purrsist-line-crossing-keeps-line-type-and-history ()
  (meow-purrsist-test--buffer "one\ntwo\nthree\nfour"
    (goto-char 6)
    (meow-line 1)
    (let ((history-size (length meow--selection-history)))
      (meow-purrsist-prev 1)
      (should (equal (cons (mark) (point)) '(8 . 1)))
      (should (equal (cons (region-beginning) (region-end)) '(1 . 8)))
      (meow-purrsist-next 1)
      (should (equal (cons (region-beginning) (region-end)) '(5 . 8)))
      (meow-purrsist-next 3)
      (should (= (region-end) (point-max)))
      (meow-purrsist-next 1)
      (should (= (region-end) (point-max)))
      (should (equal (meow--selection-type) '(expand . line)))
      (should (= (length meow--selection-history) history-size))
      (meow-pop-selection)
      (should-not (region-active-p)))))

(ert-deftest meow-purrsist-semantic-selection-can-pop-previous-bounds ()
  (meow-purrsist-test--buffer "alpha_beta gamma"
    (goto-char 3)
    (let ((last-command nil))
      (meow-purrsist-visual))
    (let ((last-command 'meow-purrsist-visual))
      (meow-purrsist-visual))
    (meow-purrsist-move-to (point-max))
    (meow-pop-selection)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 6)))
    (should (equal (meow--selection-type) '(expand . char)))))

(ert-deftest meow-purrsist-reversal-moves-new-active-end ()
  (meow-purrsist-test--buffer "alpha beta gamma"
    (goto-char 3)
    (meow-purrsist-visual)
    (meow-purrsist-next-word 1)
    (meow-reverse)
    (let ((anchor (mark)))
      (meow-purrsist-next-word 2)
      (should (= (mark) anchor))
      (meow-purrsist-back-word 1)
      (should (= (mark) anchor))
      (should (region-active-p)))))


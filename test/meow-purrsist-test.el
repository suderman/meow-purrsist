(ert-deftest meow-purrsist-find-and-till-keep-or-skip-selection ()
  (dolist (case '((meow-purrsist-find 8 19)
                  (meow-purrsist-till 7 18)
                  (meow-purrsist-find-backward 18 7)
                  (meow-purrsist-till-backward 19 8)))
    (meow-purrsist-test--buffer "alpha beta gamma beta"
      (goto-char (if (string-suffix-p "backward" (symbol-name (car case)))
                     (point-max) (point-min)))
      (funcall (car case) 1 ?b)
      (should-not (region-active-p))
      (should (= (point) (cadr case)))
      (meow-purrsist-test--region 12 13)
      (meow-purrsist-adopt-region)
      (funcall (car case) 1 ?b)
      (should (= (mark) 12))
      (should (= (point) (caddr case)))
      (should (region-active-p))
      (should (equal (meow--selection-type) '(expand . char)))
      (should (= (length meow--selection-history) 1)))))


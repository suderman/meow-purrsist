(ert-deftest meow-purrsist-lines-move-physically-and-reverse ()
  (meow-purrsist-test--buffer "one\ntwo\nthree\nfour"
    (goto-char 6)
    (meow-line 1)
    (should (equal (cons (region-beginning) (region-end)) '(5 . 8)))
    (meow-purrsist-next 2)
    (should (equal (cons (region-beginning) (region-end)) '(5 . 19)))
    (meow-purrsist-prev 2)
    (should (equal (cons (region-beginning) (region-end)) '(5 . 8)))
    (meow-purrsist-prev 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 8)))
    (should (equal (meow--selection-type) '(expand . line)))
    (meow-reverse)
    (meow-purrsist-next 1)
    (should (equal (meow--selection-type) '(expand . line)))
    (should (region-active-p))
    (should (<= (point-min) (region-beginning)))
    (should (<= (region-end) (point-max)))))

(ert-deftest meow-purrsist-lines-skip-hidden-text ()
  ;; Folded bodies follow "one" and "two", as Org and Hideshow hide them.
  (meow-purrsist-test--buffer "one\nhidden\ntwo\nhidden2\nthree"
    (overlay-put (make-overlay 4 11) 'invisible t)
    (overlay-put (make-overlay 15 23) 'invisible t)
    (meow-purrsist--select 1 4 '(expand . line))
    (meow-purrsist-next 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 23)))
    (meow-purrsist-next 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 29)))
    (meow-purrsist-prev 2)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 4)))
    (meow-purrsist--select 24 29 '(expand . line))
    (meow-purrsist-prev 1)
    (should (equal (cons (region-beginning) (region-end)) '(12 . 29)))
    ;; A click after a folded line leaves point at the end of its body.
    (deactivate-mark)
    (goto-char 23)
    (let ((last-command nil))
      (meow-purrsist-line-or-rectangle 1))
    (should (= (region-beginning) 12))))

(ert-deftest meow-purrsist-lines-skip-blank-line-after-fold ()
  ;; Org hides a folded body through its last newline, so the blank line
  ;; after it shows on the heading's line.  Moving up from "two" used to
  ;; stop on that blank line.
  (meow-purrsist-test--buffer "one\nhidden\n\ntwo"
    (overlay-put (make-overlay 4 12) 'invisible t)
    (meow-purrsist--select 13 16 '(expand . line))
    (meow-purrsist-prev 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 16)))
    (meow-purrsist--select 1 4 '(expand . line))
    (meow-purrsist-next 1)
    (should (equal (cons (region-beginning) (region-end)) '(1 . 16)))))


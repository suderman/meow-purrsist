;;; meow-purrsist-test.el --- Persistent selection checks -*- lexical-binding: t; -*-

;;; Code:

(require 'ert)
(require 'meow-purrsist)

(defmacro meow-purrsist-test--buffer (text &rest body)
  "Run BODY in a Lisp buffer containing TEXT with active regions enabled."
  (declare (indent 1))
  `(let ((transient-mark-mode t)
         (meow--selection-history nil))
     (with-temp-buffer
       (emacs-lisp-mode)
       (insert ,text)
       ,@body)))

(defun meow-purrsist-test--region (anchor active)
  "Set ordinary Emacs region from ANCHOR to ACTIVE."
  (goto-char active)
  (set-mark anchor)
  (activate-mark))

(ert-deftest meow-purrsist-adopts-native-regions-in-both-directions ()
  (dolist (bounds '((1 . 6) (6 . 1)))
    (meow-purrsist-test--buffer "alpha beta gamma"
      (meow-purrsist-test--region (car bounds) (cdr bounds))
      (meow-purrsist-adopt-region)
      (should (equal (cons (mark) (point)) bounds))
      (should (region-active-p))
      (should (equal (meow--selection-type) '(expand . char)))
      (meow-purrsist-move-to 12)
      (should (= (mark) (car bounds)))
      (should (= (point) 12))
      (should (= (length meow--selection-history) 1)))))

(ert-deftest meow-purrsist-word-motion-keeps-anchor-across-crossing ()
  (meow-purrsist-test--buffer "alpha beta gamma delta"
    (goto-char 3)
    (meow-purrsist-next-word 2)
    (should (= (point) 11))
    (should-not (region-active-p))
    (meow-purrsist-test--region 12 8)
    (meow-purrsist-adopt-region)
    (meow-purrsist-back-word 1)
    (should (equal (cons (mark) (point)) '(12 . 7)))
    (meow-purrsist-next-word 1)
    (should (equal (cons (mark) (point)) '(12 . 11)))
    (meow-purrsist-next-word 2)
    (should (equal (cons (mark) (point)) '(12 . 23)))
    (meow-purrsist-back-word 2)
    (should (= (mark) 12))
    (should (region-active-p))))

(ert-deftest meow-purrsist-symbol-motion-uses-symbol-boundaries ()
  (meow-purrsist-test--buffer "alpha_beta gamma-delta omega"
    (goto-char 3)
    (meow-purrsist-next-word 1)
    (should (= (point) 6))
    (goto-char 3)
    (meow-purrsist-next-symbol 1)
    (should (= (point) 11))
    (meow-purrsist-test--region 12 13)
    (meow-purrsist-adopt-region)
    (meow-purrsist-back-symbol 1)
    (should (equal (cons (mark) (point)) '(12 . 12)))
    (meow-purrsist-back-symbol 1)
    (should (= (mark) 12))
    (should (= (point) 1))
    (meow-purrsist-next-symbol 2)
    (should (= (mark) 12))
    (should (> (point) 12))))

(ert-deftest meow-purrsist-start-motions-respect-syntax-and-anchor ()
